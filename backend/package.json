{
  "name": "uspikh-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API системи «Успіх» (Express + PostgreSQL)",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/migrate.mjs --reset && node scripts/seed.mjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
